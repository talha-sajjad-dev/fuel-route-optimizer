DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to fall back to a local sqlite db (used by the default test run).
# docker-compose sets this to the postgres service.
DATABASE_URL=postgres://fuel:fuel@db:5432/fuel_route_optimizer

# Vehicle constants (see routes/domain for how these flow into VehicleProfile)
VEHICLE_MPG=10
VEHICLE_MAX_RANGE_MILES=500
# Defaults to VEHICLE_MAX_RANGE_MILES / VEHICLE_MPG (50) if unset.
VEHICLE_TANK_CAPACITY_GALLONS=50
FUEL_STATION_ROUTE_BUFFER_MILES=5

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ROUTING_PROFILE=driving
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-optimizer-assessment/1.0
